# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Postgres (compose service: hermes_dsar_postgres)
# Inside Docker Compose use the service host (matches /workspace/.env):
DATABASE_URL=postgres://hermes:hermes_dev_password@hermes_dsar_postgres:5432/hermes_dsar
# Running the API directly on the host instead? use 127.0.0.1 as the host.
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_dev_password
POSTGRES_DB=hermes_dsar

# Redis / BullMQ (compose service: hermes_dsar_redis)
REDIS_URL=redis://127.0.0.1:6379

# Object storage — S3-compatible (compose service: hermes_dsar_minio)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=dsar-evidence
S3_ACCESS_KEY=hermes
S3_SECRET_KEY=hermes_dev_password
S3_FORCE_PATH_STYLE=true

# Email (compose service: hermes_dsar_mailhog)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@privacyspace.local

# Application
APP_BASE_URL=http://localhost:3000
